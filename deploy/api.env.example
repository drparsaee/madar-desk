# Copy to /etc/madar-web/api.env and replace every placeholder.
# Keep this file root-owned and mode 0640. Never commit the real file.
MADAR_WEB_DB=/var/lib/madar-web/web.sqlite
MADAR_WEB_PUBLIC_ORIGIN=https://madar.example.com
MADAR_WEB_HOST=127.0.0.1
MADAR_WEB_PORT=8781

# Backups are encrypted with age before being retained or copied off-site.
MADAR_WEB_APP_ROOT=/opt/madar-web
MADAR_WEB_BACKUP_DIR=/var/backups/madar-web
MADAR_WEB_BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
MADAR_WEB_BACKUP_RETENTION_DAYS=14
# Optional rclone destination, e.g. remote:private-bucket/madar-web
# Leave empty until an independently administered off-site remote is configured.
MADAR_WEB_BACKUP_REMOTE=
NODE_BIN=/usr/bin/node
AGE_BIN=/usr/bin/age
RCLONE_BIN=/usr/bin/rclone
RCLONE_CONFIG=/etc/madar-web/rclone.conf
