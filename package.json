{
  "name": "madar-desk",
  "private": true,
  "version": "1.0.4",
  "description": "Personal offline task management for Windows",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "python native_app.py",
    "build": "python scripts/sync_font.py && vite build",
    "dist": "npm run dist:rc",
    "dist:rc": "python -B scripts/build_logo_rc.py --webview2 release/.madar-inno-prereq/MicrosoftEdgeWebView2RuntimeInstallerX64.exe",
    "test": "python -B tools/safe_test_runner.py"
  },
  "dependencies": {
    "@fontsource-variable/estedad": "5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.0.0"
  }
}
